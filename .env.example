# Browser-visible URL only. Do not put secrets in NUXT_PUBLIC_* variables.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only Figma OAuth configuration.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/api/auth/figma/callback

# At least 32 random bytes. Used for application security primitives.
SESSION_SECRET=

# Browser page to which the OAuth callback sends a plugin login attempt.
PLUGIN_CALLBACK_URL=http://localhost:3000/plugin/auth/success

# Session lifetime in seconds (8 hours by default).
SESSION_TTL_SECONDS=28800

# Upload policy (10 MiB by default).
MAX_UPLOAD_BYTES=10485760

# Seed only; replace before running `supabase db reset`.
SEED_ADMIN_EMAIL=admin@example.com
